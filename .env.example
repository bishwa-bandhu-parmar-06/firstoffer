DATABASE_URL=sqlite:///./jobs.db
# Default hours between polls of one source (a source can set "interval_hours" in sources.json)
POLL_INTERVAL_HOURS=3
SCHEDULER_TICK_MINUTES=15
REQUEST_TIMEOUT_SECONDS=30
# Minimum seconds between two requests to the same site
MIN_REQUEST_INTERVAL_SECONDS=1.0
MAX_CONCURRENT_SOURCES=4
MAX_JOBS_PER_SOURCE=25000
DETAIL_FETCHES_PER_RUN=300
MISSED_RUNS_BEFORE_INACTIVE=2
# Long random string; required as the X-Admin-Token header for POST /admin/poll (disabled while empty)
ADMIN_TOKEN=
# Telegram digest (see docs/telegram_setup.md). Leave empty to disable sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_EXPERIENCE=intern,fresher,junior
DIGEST_COUNTRIES=
DIGEST_MAX_JOBS=40
DIGEST_MAX_AGE_HOURS=24
DIGEST_MINUTE=5
# Public address of the dashboard, linked from the digest (e.g. https://jobs.example.com)
DASHBOARD_URL=
# Public Telegram channel, shown as a "Join on Telegram" button on the site (empty = hide the button)
TELEGRAM_CHANNEL_URL=https://t.me/firstoffer_jobs
# Telegram chat for "a job source keeps failing" alerts (your own chat with the bot; not the public channel)
ALERT_CHAT_ID=
ALERT_AFTER_FAILURES=3
# false = lite storage for small free databases (descriptions are used for tagging, then dropped)
STORE_DESCRIPTIONS=true
# Delete closed jobs this many days after they were last seen (0 = keep forever)
PRUNE_CLOSED_AFTER_DAYS=30
